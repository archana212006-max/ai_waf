# AI WAF Environment Configuration
# Copy this file to .env and fill in your values

# WAF target backend (the server to protect)
WAF_TARGET=http://localhost:9000

# WAF host and port
WAF_HOST=0.0.0.0
WAF_PORT=8000

# Log level: debug | info | warning | error
LOG_LEVEL=info

# Mode: active | monitor | disabled
WAF_MODE=active

# AI confidence threshold (0.0 - 1.0) to block a request
BLOCK_THRESHOLD=0.60

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=100
